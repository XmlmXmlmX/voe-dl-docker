@using Microsoft.AspNetCore.Components
@using MudBlazor
@using VoeDl.Web.Models

@* Primary download input — big textarea + split-button category picker. *@

<MudCard Elevation="2" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AddLink" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Neuer Download</MudText>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <MudTextField T="string"
                      Value="@RawUrls"
                      ValueChanged="OnRawUrlsChanged"
                      Immediate="true"
                      Label="URL(s) — eine pro Zeile"
                      HelperText="@HelperText"
                      Lines="4"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Placeholder="https://voe.sx/xxxxxxx&#10;https://www.arte.tv/de/videos/..."
                      Style="font-family: 'JetBrains Mono', monospace;" />

        @if (Duplicates.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Variant="Variant.Outlined">
                <MudText Typo="Typo.body2" Class="mb-1"><strong>Bereits heruntergeladen:</strong></MudText>
                @foreach (var u in Duplicates)
                {
                    <MudText Typo="Typo.caption" Style="font-family:monospace;word-break:break-all;">@u</MudText>
                }
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                               OnClick="OnForceDownload">Erneut herunterladen</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               OnClick="OnDownloadDelta">Nur Delta</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                               OnClick="OnClearDuplicateWarning">Abbrechen</MudButton>
                </MudStack>
            </MudAlert>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                @* Split-Button: primary action + dropdown for category override *@
                <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                    <MudButton StartIcon="@Icons.Material.Filled.Download"
                               OnClick="() => OnStartDownloads.InvokeAsync(DownloadCategory.Auto)"
                               Disabled="@string.IsNullOrWhiteSpace(RawUrls)">
                        Download starten
                    </MudButton>
                    <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown"
                             Color="Color.Primary"
                             Variant="Variant.Filled"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Dense="true"
                             Disabled="@string.IsNullOrWhiteSpace(RawUrls)">
                        <MudMenuItem Icon="@Icons.Material.Filled.Movie"
                                     OnClick="() => OnStartDownloads.InvokeAsync(DownloadCategory.Movie)">
                            Als Film laden
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Tv"
                                     OnClick="() => OnStartDownloads.InvokeAsync(DownloadCategory.Series)">
                            Als Serie laden
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Article"
                                     OnClick="() => OnStartDownloads.InvokeAsync(DownloadCategory.Documentary)">
                            Als Doku laden
                        </MudMenuItem>
                    </MudMenu>
                </MudButtonGroup>

                <MudButton Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           Disabled="@string.IsNullOrWhiteSpace(RawUrls)"
                           OnClick="ClearInput">
                    Leeren
                </MudButton>
            </MudStack>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string RawUrls { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> RawUrlsChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Duplicates { get; set; } = [];
    [Parameter] public EventCallback<DownloadCategory> OnStartDownloads { get; set; }
    [Parameter] public EventCallback OnForceDownload { get; set; }
    [Parameter] public EventCallback OnDownloadDelta { get; set; }
    [Parameter] public EventCallback OnClearDuplicateWarning { get; set; }

    private int UrlCount => RawUrls
        .Split('\n', StringSplitOptions.RemoveEmptyEntries)
        .Count(l => !string.IsNullOrWhiteSpace(l));

    private string HelperText => $"Unterstützt yt-dlp-kompatible URLs · {UrlCount} URL(s) erkannt";

    private Task OnRawUrlsChanged(string value)
    {
        RawUrls = value;
        return RawUrlsChanged.InvokeAsync(value);
    }

    private Task ClearInput() => RawUrlsChanged.InvokeAsync(string.Empty);
}
