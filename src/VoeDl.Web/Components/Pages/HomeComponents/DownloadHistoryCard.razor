@using Microsoft.AspNetCore.Components
@using MudBlazor
@using VoeDl.Web.Models

@* Compact history list with category icon, title, meta, date and replay action. *@

<MudCard Elevation="2" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Heruntergeladen</MudText>
            </MudStack>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudChip T="string" Color="Color.Default" Size="Size.Small">@History.Count</MudChip>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent Class="pa-0">
        @if (History.Count == 0)
        {
            <MudPaper Class="d-flex flex-column align-center justify-center pa-8" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.subtitle1" Class="mt-2">Noch keine URLs heruntergeladen</MudText>
            </MudPaper>
        }
        else if (HistoryEntries.Count > 0)
        {
            <MudList T="DownloadHistoryEntry" Dense="true" Style="max-height:420px;overflow-y:auto;">
                @foreach (var entry in HistoryEntries)
                {
                    <MudListItem T="DownloadHistoryEntry" Value="entry">
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="w-100">
                            <MudIcon Icon="@(entry.Success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Color="@(entry.Success ? Color.Success : Color.Error)" Size="Size.Small" />
                            <div class="flex-grow-1" style="min-width:0;">
                                <MudLink Href="@entry.Url" Target="_blank" rel="noopener"
                                         Typo="Typo.body2" Color="Color.Default"
                                         Style="font-weight:500;word-break:break-word;">
                                    @(entry.Title ?? entry.Url)
                                </MudLink>
                                @if (!string.IsNullOrEmpty(entry.Title))
                                {
                                    <MudText Typo="Typo.caption"
                                             Style="font-family:monospace;word-break:break-all;display:block;">
                                        @entry.Url
                                    </MudText>
                                }
                            </div>
                            <MudText Typo="Typo.caption"
                                     Style="font-variant-numeric:tabular-nums;flex-shrink:0;">
                                @entry.FinishedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudList T="string" Dense="true" Style="max-height:420px;overflow-y:auto;">
                @foreach (var url in ((IEnumerable<string>)History).Reverse())
                {
                    <MudListItem T="string" Value="url">
                        <MudLink Href="@url" Target="_blank" rel="noopener"
                                 Typo="Typo.caption"
                                 Style="font-family:monospace;word-break:break-all;">
                            @url
                        </MudLink>
                    </MudListItem>
                }
            </MudList>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public IReadOnlyList<string> History { get; set; } = [];
    [Parameter] public IReadOnlyList<DownloadHistoryEntry> HistoryEntries { get; set; } = [];
}
