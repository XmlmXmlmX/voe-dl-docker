@using Microsoft.AspNetCore.Components
@using MudBlazor
@using VoeDl.Web.Models

<MudCard Elevation="2" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Heruntergeladene URLs</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudChip T="string" Color="Color.Default" Size="Size.Small">@History.Count</MudChip>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-0">
        @if (History.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                Noch keine URLs heruntergeladen.
            </MudText>
        }
        else if (HistoryEntries.Count > 0)
        {
            <ul class="list-group list-group-flush">
                @foreach (var entry in HistoryEntries)
                {
                    <li class="list-group-item py-1 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="@entry.Url" target="_blank" rel="noopener"
                               class="text-decoration-none font-monospace small text-muted text-truncate me-2"
                               style="max-width:70%;">
                                @(entry.Title ?? entry.Url)
                            </a>
                            <span class="text-muted small flex-shrink-0">
                                @entry.FinishedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>
                        @if (entry.Title is not null)
                        {
                            <small class="text-muted font-monospace" style="font-size:.7rem;">@entry.Url</small>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <MudList T="string" Dense="true" Style="max-height:220px; overflow-y:auto;">
                @foreach (var url in ((IEnumerable<string>)History).Reverse())
                {
                    <MudListItem T="string">
                        <MudLink Href="@url" Target="_blank" rel="noopener"
                                 Typo="Typo.caption" Style="font-family:monospace; word-break:break-all;">
                            @url
                        </MudLink>
                    </MudListItem>
                }
            </MudList>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public IReadOnlyList<string> History { get; set; } = [];

    [Parameter]
    public IReadOnlyList<DownloadHistoryEntry> HistoryEntries { get; set; } = [];
}
