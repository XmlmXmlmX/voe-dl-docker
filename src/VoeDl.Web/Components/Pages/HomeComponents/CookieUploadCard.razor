@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@using VoeDl.Web.Services
@inject CookieStoreService CookieStore
@inject ISnackbar Snackbar

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudText Typo="Typo.h6">YouTube / yt-dlp Cookies</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Lade hier eine cookies.txt-Datei hoch, die von yt-dlp verwendet werden soll.
            Dies ist nützlich für altersbeschränkte oder private Inhalte, die nur mit angemeldeten Cookies verfügbar sind.
        </MudText>

        @if (!CookieStore.IsDatabaseConfigured)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                PostgreSQL ist nicht konfiguriert. Cookie-Speicherung im DB ist deaktiviert.
            </MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" md="8">
                    <InputFile OnChange="OnInputFileChange" accept=".txt" />
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="!_cookieAvailable"
                               OnClick="RemoveCookie">
                        Cookie entfernen
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                @if (_cookieAvailable)
                {
                    <span>Aktuelles Cookie gespeichert: @_cookieUploadedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                }
                else
                {
                    <span>Kein yt-dlp Cookie gespeichert.</span>
                }
            </MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    private bool _cookieAvailable;
    private DateTimeOffset? _cookieUploadedAt;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs args)
    {
        if (!CookieStore.IsDatabaseConfigured)
        {
            Snackbar.Add("Cookie-Speicherung ist ohne Datenbank nicht möglich.", Severity.Error);
            return;
        }

        var file = args.File;
        if (file == null)
            return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5_000_000);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var content = await reader.ReadToEndAsync();

            await CookieStore.SaveCookieAsync(content);
            await RefreshStatusAsync();
            Snackbar.Add("Cookie erfolgreich gespeichert.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Speichern des Cookies: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveCookie()
    {
        if (!CookieStore.IsDatabaseConfigured)
            return;

        await CookieStore.DeleteCookieAsync();
        await RefreshStatusAsync();
        Snackbar.Add("Cookie entfernt.", Severity.Success);
    }

    private async Task RefreshStatusAsync()
    {
        _cookieAvailable = await CookieStore.HasStoredCookieAsync();
        _cookieUploadedAt = await CookieStore.GetCookieUploadedAtAsync();
    }
}
