@page "/"
@rendermode InteractiveServer
@using VoeDl.Web.Models
@using VoeDl.Web.Services
@inject JobManagerService JobManager
@inject IConfiguration Config
@implements IDisposable

<PageTitle>voe-dl</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">

    <MudText Typo="Typo.subtitle1" Class="mb-4" Color="Color.Secondary">
        Videos von <MudLink Href="https://voe.sx" Target="_blank" rel="noopener">voe.sx</MudLink> herunterladen
    </MudText>

    <!-- Input form -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <EditForm Model="_model" OnValidSubmit="StartDownloads">
                <MudTextField @bind-Value="_model.RawUrls"
                              Label="URL(s) eingeben"
                              HelperText="Eine URL pro Zeile"
                              Lines="4"
                              Variant="Variant.Outlined"
                              Class="mb-2"
                              Placeholder="https://voe.sx/xxxxxxx&#10;https://voe.sx/yyyyyyy"
                              Style="font-family: monospace;" />

                @if (_duplicates.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3" Variant="Variant.Outlined">
                        <MudText Typo="Typo.body2" Class="mb-1"><strong>Bereits heruntergeladen:</strong></MudText>
                        @foreach (var u in _duplicates)
                        {
                            <MudText Typo="Typo.caption" Style="font-family:monospace; word-break:break-all;">@u</MudText>
                        }
                        <div class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                       Class="mr-2" OnClick="ForceDownload">Erneut herunterladen</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       OnClick="ClearDuplicateWarning">Abbrechen</MudButton>
                        </div>
                    </MudAlert>
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                               Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download">
                        Download starten
                    </MudButton>
                }
            </EditForm>
        </MudCardContent>
    </MudCard>

    <!-- Download history -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Heruntergeladene URLs</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudChip T="string" Color="Color.Default" Size="Size.Small">@_history.Count</MudChip>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent Class="pa-0">
            @if (_history.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                    Noch keine URLs heruntergeladen.
                </MudText>
            }
            else if (_historyEntries.Count > 0)
            {
                <ul class="list-group list-group-flush">
                    @foreach (var entry in _historyEntries)
                    {
                        <li class="list-group-item py-1 px-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="@entry.Url" target="_blank" rel="noopener"
                                   class="text-decoration-none font-monospace small text-muted text-truncate me-2"
                                   style="max-width:70%;">
                                    @(entry.Title ?? entry.Url)
                                </a>
                                <span class="text-muted small flex-shrink-0">
                                    @entry.FinishedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                            @if (entry.Title is not null)
                            {
                                <small class="text-muted font-monospace" style="font-size:.7rem;">@entry.Url</small>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <MudList T="string" Dense="true" Style="max-height:220px; overflow-y:auto;">
                    @foreach (var url in ((IEnumerable<string>)_history).Reverse())
                    {
                        <MudListItem T="string">
                            <MudLink Href="@url" Target="_blank" rel="noopener"
                                     Typo="Typo.caption" Style="font-family:monospace; word-break:break-all;">
                                @url
                            </MudLink>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    </MudCard>

    <!-- Job list header -->
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h6">Downloads</MudText>
        @if (_lastUpdated.HasValue)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Zuletzt aktualisiert: @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss")
            </MudText>
        }
    </div>

    @if (_jobs.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Noch keine Downloads gestartet.</MudText>
    }
    else
    {
        @foreach (var job in _jobs)
        {
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-start">
                        <div style="min-width:0; flex:1; margin-right:12px;">
                            <MudLink Href="@job.Url" Target="_blank" rel="noopener"
                                     Typo="Typo.body1" Color="Color.Default"
                                     Style="word-break:break-all;">
                                @(job.Title ?? job.Url)
                            </MudLink>
                            @if (job.Title is not null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="font-family:monospace; word-break:break-all;">
                                    @job.Url
                                </MudText>
                            }
                        </div>
                        <div class="d-flex align-center flex-shrink-0">
                            @if (job.Status == JobStatus.Running)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                     Color="Color.Primary" Class="mr-2" />
                            }
                            <MudChip T="string" Color="@StatusChipColor(job.Status)"
                                     Size="Size.Small" Class="mr-1">
                                @job.Status.ToString().ToLowerInvariant()
                            </MudChip>
                            @if (job.Status is JobStatus.Pending or JobStatus.Running)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Stop"
                                               Color="Color.Error" Size="Size.Small"
                                               title="Abbrechen"
                                               OnClick="() => AbortJob(job.Id)" />
                            }
                            else if (job.Status is JobStatus.Done or JobStatus.Error or JobStatus.Aborted)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Replay"
                                               Color="Color.Default" Size="Size.Small"
                                               title="Erneut herunterladen"
                                               OnClick="() => RequeueJob(job.Id)" />
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(job.Logs))
                    {
                        <MudExpansionPanels Class="mt-2" Elevation="0">
                            <MudExpansionPanel Text="@(job.Status == JobStatus.Running ? "Live-Log" : "Log anzeigen")"
                                               Expanded="@(job.Status == JobStatus.Running)"
                                               Dense="true">
                                <div class="log-box">@job.Logs</div>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                </MudCardContent>
            </MudCard>
        }
    }

    <MudDivider Class="mt-4 mb-2" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
        voe-dl-docker @(Config["APP_VERSION"] ?? "dev")
    </MudText>

</MudContainer>

@code {
    private sealed class DownloadModel
    {
        public string RawUrls { get; set; } = string.Empty;
    }

    private readonly DownloadModel _model = new();
    private List<DownloadJob> _jobs = [];
    private List<string> _history = [];
    private List<DownloadHistoryEntry> _historyEntries = [];
    private List<string> _duplicates = [];
    private DateTimeOffset? _lastUpdated;

    protected override async Task OnInitializedAsync()
    {
        JobManager.JobsChanged += OnJobsChanged;
        _jobs = [.. JobManager.GetJobs()];
        _history = [.. await JobManager.LoadHistoryAsync()];
        _historyEntries = [.. await JobManager.LoadHistoryEntriesAsync()];
    }

    private void OnJobsChanged()
    {
        _jobs = [.. JobManager.GetJobs()];
        _lastUpdated = DateTimeOffset.UtcNow;
        // Refresh history in the background when a job finishes
        var recentlyFinished = _jobs.Any(j =>
            j.Status is JobStatus.Done &&
            j.FinishedAt.HasValue &&
            DateTimeOffset.UtcNow - j.FinishedAt.Value < TimeSpan.FromSeconds(5));
        if (recentlyFinished)
        {
            InvokeAsync(async () =>
            {
                _history = [.. await JobManager.LoadHistoryAsync()];
                _historyEntries = [.. await JobManager.LoadHistoryEntriesAsync()];
                StateHasChanged();
            });
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartDownloads()
    {
        var urls = ParseUrls(_model.RawUrls);
        if (urls.Count == 0) return;

        // Check for duplicates against download history
        var dupes = urls.Where(_history.Contains).ToList();
        if (dupes.Count > 0)
        {
            _duplicates = dupes;
            return;
        }

        EnqueueAll(urls);
    }

    private void ForceDownload()
    {
        var urls = ParseUrls(_model.RawUrls);
        _duplicates = [];
        EnqueueAll(urls);
    }

    private void ClearDuplicateWarning() => _duplicates = [];

    private void EnqueueAll(List<string> urls)
    {
        foreach (var url in urls)
            JobManager.Enqueue(url);
        _model.RawUrls = string.Empty;
        _duplicates = [];
    }

    private void AbortJob(string id) => JobManager.Abort(id);

    private void RequeueJob(string id) => JobManager.Requeue(id);

    private static List<string> ParseUrls(string raw) =>
        raw.Split('\n', StringSplitOptions.RemoveEmptyEntries)
           .Select(l => l.Trim())
           .Where(l => l.Length > 0 && !l.StartsWith('#'))
           .ToList();

    private static Color StatusChipColor(JobStatus status) => status switch
    {
        JobStatus.Done    => Color.Success,
        JobStatus.Error   => Color.Error,
        JobStatus.Running => Color.Primary,
        JobStatus.Aborted => Color.Warning,
        _                 => Color.Default,
    };

    public void Dispose() => JobManager.JobsChanged -= OnJobsChanged;
}
