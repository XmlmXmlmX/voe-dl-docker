@page "/"
@rendermode InteractiveServer
@using VoeDl.Web.Models
@using VoeDl.Web.Services
@using VoeDl.Web.Components.Pages.HomeComponents
@using Microsoft.Extensions.Logging
@inject IJobManagerService JobManager
@inject MediathekViewWebService MediathekViewWeb
@inject IConfiguration Config
@inject ISnackbar Snackbar
@inject ILogger<Home> Logger
@implements IDisposable

<PageTitle>voe-dl</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6">MediathekViewWeb-Suche</MudText>
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField T="string"
                                  @bind-Value="_mediathekQuery"
                                  Label="Suchbegriff"
                                  Placeholder="z. B. 8 blickwink"
                                  Lines="1"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Class="mb-2" />
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@string.IsNullOrWhiteSpace(_mediathekQuery)"
                               OnClick="SearchMediathek">
                        Suche starten
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudCheckBox T="bool" @bind-Checked="_mediathekEverywhere" Label="Überall suchen" />
            @if (_mediathekIsLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-2" />
            }
            @if (!string.IsNullOrWhiteSpace(_mediathekError))
            {
                <MudText Color="Color.Error">@_mediathekError</MudText>
            }

            @if (_mediathekResults.Count > 0)
            {
                <MudTable Items="_mediathekResults" Hover="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Titel</MudTh>
                        <MudTh>Kategorie</MudTh>
                        <MudTh>Sender</MudTh>
                        <MudTh>Veröffentlicht</MudTh>
                        <MudTh>Aktion</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Titel">@context.Title</MudTd>
                        <MudTd DataLabel="Kategorie">@context.Category</MudTd>
                        <MudTd DataLabel="Sender">@context.Creator</MudTd>
                        <MudTd DataLabel="Veröffentlicht">@context.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => EnqueueMediathekResult(context.MediaUrl)">
                                Download
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>

    <DownloadInputCard
        RawUrls="@_model.RawUrls"
        RawUrlsChanged="OnRawUrlsChanged"
        Duplicates="@_duplicates"
        OnStartDownloads="StartDownloads"
        OnForceDownload="ForceDownload"
        OnDownloadDelta="DownloadDelta"
        OnClearDuplicateWarning="ClearDuplicateWarning" />

    <DownloadHistoryCard
        History="@_history"
        HistoryEntries="@_historyEntries" />

    <!-- Job list header -->
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.h6">Downloads</MudText>
        @if (_lastUpdated.HasValue)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Zuletzt aktualisiert: @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss")
            </MudText>
        }
    </div>

    @if (_jobs.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Noch keine Downloads gestartet.</MudText>
    }
    else
    {
        @foreach (var job in _jobs)
        {
            <DownloadJobCard
                Job="@job"
                QueuePosition="@GetQueuePosition(job)"
                OnAbort="AbortJob"
                OnRequeue="RequeueJob" />
        }
    }

    <MudDivider Class="mt-4 mb-2" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
        voe-dl-docker @(Config["APP_VERSION"] ?? "dev")
    </MudText>

</MudContainer>

@code {
    private sealed class DownloadModel
    {
        public string RawUrls { get; set; } = string.Empty;
    }

    private readonly DownloadModel _model = new();
    private List<DownloadJob> _jobs = [];
    private List<string> _history = [];
    private List<DownloadHistoryEntry> _historyEntries = [];
    private List<string> _duplicates = [];
    private List<string> _resolvedUrlsAwaitingConfirmation = [];
    private List<string> _deltaUrlsAwaitingConfirmation = [];
    private string _mediathekQuery = string.Empty;
    private bool _mediathekEverywhere = true;
    private List<MediathekViewWebResult> _mediathekResults = [];
    private bool _mediathekIsLoading;
    private string? _mediathekError;
    private DateTimeOffset? _lastUpdated;
    private readonly HashSet<string> _notifiedTerminalJobs = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            JobManager.JobsChanged += OnJobsChanged;
            _jobs = [.. JobManager.GetJobs()];
            Logger.LogInformation("Loaded {JobCount} existing download jobs", _jobs.Count);

            _history = [.. await JobManager.LoadHistoryAsync()];
            Logger.LogInformation("Loaded {HistoryCount} URLs from download history", _history.Count);

            _historyEntries = [.. await JobManager.LoadHistoryEntriesAsync()];
            Logger.LogInformation("Loaded {HistoryEntriesCount} history entries from database", _historyEntries.Count);

            foreach (var terminalJob in _jobs.Where(j => j.Status is JobStatus.Done or JobStatus.Error or JobStatus.Aborted))
                _notifiedTerminalJobs.Add(terminalJob.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during Home component initialization: {ErrorMessage}", ex.Message);
            Snackbar.Add($"Fehler beim Laden der Download-Historie: {ex.Message}", Severity.Error);
            // Component still renders but with empty history - download button is still available
        }
    }

    private void OnJobsChanged()
    {
        _jobs = [.. JobManager.GetJobs()];
        _lastUpdated = DateTimeOffset.UtcNow;

        var newlyCompletedJobs = _jobs
            .Where(j => j.Status is JobStatus.Done or JobStatus.Error or JobStatus.Aborted && _notifiedTerminalJobs.Add(j.Id))
            .ToList();

        foreach (var completedJob in newlyCompletedJobs)
        {
            var jobLabel = completedJob.Title ?? completedJob.Url;
            if (completedJob.Status == JobStatus.Done)
            {
                Snackbar.Add($"Download abgeschlossen: {jobLabel}", Severity.Success);
            }
            else if (completedJob.Status == JobStatus.Error)
            {
                Snackbar.Add($"Download fehlgeschlagen: {jobLabel}", Severity.Error);
            }
            else if (completedJob.Status == JobStatus.Aborted)
            {
                Snackbar.Add($"Download abgebrochen: {jobLabel}", Severity.Warning);
            }
        }

        // Refresh history in the background when a job finishes
        var recentlyFinished = _jobs.Any(j =>
            j.Status is JobStatus.Done &&
            j.FinishedAt.HasValue &&
            DateTimeOffset.UtcNow - j.FinishedAt.Value < TimeSpan.FromSeconds(5));
        if (recentlyFinished)
        {
            InvokeAsync(async () =>
            {
                _history = [.. await JobManager.LoadHistoryAsync()];
                _historyEntries = [.. await JobManager.LoadHistoryEntriesAsync()];
                StateHasChanged();
            });
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartDownloads()
    {
        var inputUrls = ParseUrls(_model.RawUrls);
        if (inputUrls.Count == 0) return;

        try
        {
            var urls = await ResolveUrlsAsync(inputUrls);
            if (urls.Count == 0)
            {
                Snackbar.Add("Keine gültigen URLs gefunden.", Severity.Error);
                Logger.LogWarning("No valid URLs resolved from input");
                return;
            }

            _resolvedUrlsAwaitingConfirmation = urls;
            Logger.LogInformation("Resolved {UrlCount} URLs for download", urls.Count);

            // Check for duplicates against download history
            var dupes = urls.Where(_history.Contains).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (dupes.Count > 0)
            {
                _duplicates = dupes;
                _deltaUrlsAwaitingConfirmation = urls
                    .Except(dupes, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                Logger.LogInformation("Found {DuplicateCount} duplicate URLs out of {Total}", dupes.Count, urls.Count);
                return;
            }

            _deltaUrlsAwaitingConfirmation = [];
            EnqueueAll(urls);
            Snackbar.Add($"{urls.Count} Download(s) gestartet.", Severity.Success);
            Logger.LogInformation("Enqueued {UrlCount} downloads", urls.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during StartDownloads: {ErrorMessage}", ex.Message);
            Snackbar.Add($"Fehler beim Starten der Downloads: {ex.Message}", Severity.Error);
        }
    }

    private async Task ForceDownload()
    {
        List<string> urls = _resolvedUrlsAwaitingConfirmation.Count > 0
            ? new List<string>(_resolvedUrlsAwaitingConfirmation)
            : await ResolveUrlsAsync(ParseUrls(_model.RawUrls));

        _duplicates = [];
        _deltaUrlsAwaitingConfirmation = [];
        _resolvedUrlsAwaitingConfirmation = [];
        EnqueueAll(urls);
    }

    private void DownloadDelta()
    {
        List<string> delta = _deltaUrlsAwaitingConfirmation.Count > 0
            ? new List<string>(_deltaUrlsAwaitingConfirmation)
            : [];

        _duplicates = [];
        _deltaUrlsAwaitingConfirmation = [];
        _resolvedUrlsAwaitingConfirmation = [];

        if (delta.Count == 0)
        {
            Snackbar.Add("Keine neuen Folgen gefunden.", Severity.Info);
            return;
        }

        EnqueueAll(delta);
    }

    private void ClearDuplicateWarning()
    {
        _duplicates = [];
        _deltaUrlsAwaitingConfirmation = [];
        _resolvedUrlsAwaitingConfirmation = [];
    }

    private async Task SearchMediathek()
    {
        _mediathekError = null;
        _mediathekResults = [];
        _mediathekIsLoading = true;

        try
        {
            var results = await MediathekViewWeb.SearchAsync(_mediathekQuery, _mediathekEverywhere);
            _mediathekResults = [.. results];
            if (_mediathekResults.Count == 0)
                _mediathekError = "Keine Ergebnisse gefunden.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "MediathekViewWeb search failed: {ErrorMessage}", ex.Message);
            _mediathekError = "Fehler bei der Mediathek-Suche. Bitte später erneut versuchen.";
        }
        finally
        {
            _mediathekIsLoading = false;
        }
    }

    private void EnqueueMediathekResult(string url)
    {
        JobManager.Enqueue(url);
        Snackbar.Add("MediathekViewWeb-Download gestartet.", Severity.Success);
    }

    private void EnqueueAll(List<string> urls)
    {
        foreach (var url in urls)
            JobManager.Enqueue(url);
        _model.RawUrls = string.Empty;
        _duplicates = [];
    }

    private void AbortJob(string id) => JobManager.Abort(id);

    private void RequeueJob(string id) => JobManager.Requeue(id);

    private Task OnRawUrlsChanged(string value)
    {
        _model.RawUrls = value;
        return Task.CompletedTask;
    }

    private static List<string> ParseUrls(string raw) =>
        raw.Split('\n', StringSplitOptions.RemoveEmptyEntries)
           .Select(l => l.Trim())
           .Where(l => l.Length > 0 && !l.StartsWith('#'))
           .ToList();

    private async Task<List<string>> ResolveUrlsAsync(List<string> inputUrls)
    {
        var resolved = new List<string>();

        foreach (var inputUrl in inputUrls)
        {
            try
            {
                var expanded = await JobManager.ResolveInputUrlsAsync(inputUrl);
                resolved.AddRange(expanded);
                Logger.LogInformation("Resolved URL '{InputUrl}' to {ExpandedCount} URLs", inputUrl, expanded.Count);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to resolve URL '{InputUrl}', adding original URL as fallback. Error: {ErrorMessage}", inputUrl, ex.Message);
                // If expansion fails, keep the original input URL so the user can still download directly.
                resolved.Add(inputUrl);
            }
        }

        return resolved
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private int? GetQueuePosition(DownloadJob job)
    {
        if (job.Status != JobStatus.Queued)
            return null;

        var queued = _jobs
            .Where(j => j.Status == JobStatus.Queued)
            .OrderBy(j => j.CreatedAt)
            .Select((j, idx) => new { j.Id, Position = idx + 1 })
            .FirstOrDefault(x => x.Id == job.Id);

        return queued?.Position;
    }

    public void Dispose() => JobManager.JobsChanged -= OnJobsChanged;
}
